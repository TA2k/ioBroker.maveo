{
  "i18n": true,
  "type": "panel",
  "items": {
    "_header": {
      "type": "header",
      "text": "Maveo",
      "size": 4,
      "newLine": true
    },
    "_intro": {
      "type": "staticText",
      "newLine": true,
      "text": "Two modes: Cloud (Cognito login + nymea proxy) is used by default. Set 'boxIp' to switch to LAN mode (direct JSON-RPC to the box, push-button auth on first start).",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_cloud": {
      "type": "header",
      "text": "Cloud mode",
      "size": 5,
      "newLine": true
    },
    "username": {
      "type": "text",
      "label": "App Email",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "password": {
      "type": "password",
      "label": "App Password",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "repeat": false
    },
    "region": {
      "type": "select",
      "label": "Region",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 3,
      "xl": 3,
      "options": [
        {
          "value": "eu",
          "label": "Europe (eu-central-1)"
        },
        {
          "value": "us",
          "label": "United States (us-west-2)"
        }
      ]
    },
    "wakeTopic": {
      "type": "text",
      "label": "IoT wake topic (optional)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 8,
      "xl": 8,
      "help": "AWS IoT topic used to wake the box before connecting to the proxy. Leave empty to skip."
    },
    "_lan": {
      "type": "header",
      "text": "LAN mode (direct connection to the box)",
      "size": 5,
      "newLine": true
    },
    "_lan_hint": {
      "type": "staticText",
      "newLine": true,
      "text": "As soon as 'Maveo box IP' is set, LAN mode is active and cloud settings above are ignored. On first start you have up to 5 minutes to press the yellow button on the maveo box; the token is stored encrypted and reused on subsequent starts.",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "boxIp": {
      "type": "text",
      "label": "Maveo box IP",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4,
      "placeholder": "e.g. 192.168.1.42"
    },
    "boxPort": {
      "type": "number",
      "label": "Port (0 = auto probe 2222/4444)",
      "min": 0,
      "max": 65535,
      "step": 1,
      "xs": 12,
      "sm": 6,
      "md": 3,
      "lg": 2,
      "xl": 2
    },
    "boxTls": {
      "type": "checkbox",
      "label": "TLS",
      "xs": 12,
      "sm": 3,
      "md": 2,
      "lg": 1,
      "xl": 1
    },
    "boxWs": {
      "type": "checkbox",
      "label": "WebSocket (only used with explicit port)",
      "xs": 12,
      "sm": 9,
      "md": 7,
      "lg": 5,
      "xl": 5
    },
    "pushButtonWindow": {
      "type": "number",
      "label": "Push-button window (seconds)",
      "newLine": true,
      "min": 30,
      "max": 900,
      "step": 10,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 3,
      "xl": 3,
      "help": "Time to walk to the box and press the yellow button on first LAN setup. Default 300 s."
    }
  }
}
